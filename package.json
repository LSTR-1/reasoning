{
  "name": "mcp",
  "author": "Florentin One (https://florentin-one.de)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florentin-one-cloud/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/florentin-one-cloud/mcp/issues"
  },
  "description": "Florentin One Model Context Protocol (MCP) servers",
  "homepage": "https://florentin-one.de",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "src/*"
  ],
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build-all": "pnpm -r build",
    "test": "pnpm exec vitest run",
    "test:unit": "pnpm exec vitest run --project unit",
    "test:integration": "pnpm exec vitest run --project integration",
    "test:e2e": "pnpm exec vitest run --project e2e",
    "test:all": "pnpm -r test",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:coverage:all": "pnpm -r test -- --coverage",
    "test:history": "npx tsx scripts/test-history.ts",
    "test:cleanup": "npx tsx scripts/test-cleanup.ts",
    "format": "prettier --write . && eslint . --ext .ts,.tsx --fix",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "eslint": "9.37.0",
    "globals": "15.15.0",
    "markdownlint": "0.38.0",
    "miniflare": "5.20260815.0-alpha",
    "prettier": "3.6.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.3",
    "wrangler": "4.115.0"
  },
  "prettier": {
    "trailingComma": "none",
    "printWidth": 120,
    "proseWrap": "always",
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          ".github/workflows/*.yml"
        ],
        "options": {
          "proseWrap": "never",
          "objectWrap": "collapse"
        }
      }
    ]
  }
}
